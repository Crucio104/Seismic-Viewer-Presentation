\contentsline {figure}{\numberline {5.1}{\ignorespaces The 2D Geospatial Map View in the Seismic Viewer. This workspace allows users to filter earthquake data (\subref {fig:2d-viz}) and combine it with advanced geophysical overlays, such as tomographic velocity maps (\subref {fig:2d-viz-tomo}) and ground uplift measurements (\subref {fig:2d-viz-uplift}).}}{23}{figure.caption.29}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces The 3D Static View workspace. The user can explore the underground earthquake distribution (\subref {fig:3d-viz}) and combine it with 3D tomography models (\subref {fig:3d-viz-tomo}) and surface deformation data (\subref {fig:3d-viz-uplift}).}}{25}{figure.caption.32}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces The 4D Animated Spatio-Temporal View workflow. Users configure parameters via the dialog (\subref {fig:anim-menu}), explore time-evolving seismicity (\subref {fig:anim-viz}), and observe automated fault plane tracking (\subref {fig:anim-cylinder-planes}).}}{27}{figure.caption.35}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Multi-scale static (\subref {fig:cluster-viz}) and animated (\subref {fig:anim-clustering-noplanes} to \subref {fig:anim-clustering-unified}) 3D/4D Cluster Analysis modes (Part 1).}}{29}{figure.caption.36}%
